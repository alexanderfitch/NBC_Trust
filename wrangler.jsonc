{
  // Deploys the production microsite build as static assets; run `make deploy`,
  // which stages microsite/dist under microsite/deploy/succession/. Never point this at a --local
  // build: that one contains the confidential prospect dashboard.
  "name": "nbc-trust",
  "compatibility_date": "2026-09-29",
  "account_id": "42e46fbf5ee1e843646addc0bac4a9b3",
  "assets": {
    "directory": "microsite/deploy",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
